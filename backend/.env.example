# 智谱开放平台 https://bigmodel.cn 注册后获取(API Key)
ZHIPU_API_KEY=
# OpenAI 兼容端点(官方文档:https://docs.bigmodel.cn/cn/guide/platform/model-migration)
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# 聊天模型(当前使用 glm-5.3-flash 混合推理;免费档可用 glm-4-flash)
CHAT_MODEL=glm-5.3-flash
# 向量模型与维度(支持 256/512/1024/2048)
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIM=1024
# 无 API Key 时置 1:用本地伪向量干跑整条 RAG 链路(仅开发自测,检索质量无意义)
EMBED_FAKE=0

# ----- 检索(RAG)超参数,详见 docs/rag-hybrid-design.md -----
# 检索模式:dense=纯向量(旧行为) | hybrid=BM25×向量 双路召回+融合+交叉编码器重排(默认)
RETRIEVAL_MODE=hybrid
# 稠密路/稀疏路候选深度与权重(当前为调优最优值,网格搜索见 scripts/tune_rag.py)
DENSE_TOPK=50
BM25_TOPK=50
DENSE_WEIGHT=1.0
BM25_WEIGHT=1.0
# 融合:weighted=分数归一加权(调优最优) | rrf=倒数排名融合
FUSION=weighted
RRF_K=60
HYBRID_ALPHA=0.5
# 重排:zhipu=智谱 rerank API(交叉编码器,默认) | local=本地 cross-encoder
# (需 uv sync --extra rerank-local) | off
RERANK_PROVIDER=zhipu
RERANK_MODEL=rerank
RERANK_CANDIDATES=20
# 重排后返回给 LLM 的知识块数
HYBRID_FINAL_K=5

# ----- 查询拆分(分点检索) -----
# 1=开启:LLM 子 agent 先把问题拆成 ≤N 个检索点,逐点召回后融合(拆分失败自动退回整句检索)
QUERY_DECOMPOSITION=1
DECOMP_MAX_QUERIES=3

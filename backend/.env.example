# 智谱开放平台 https://bigmodel.cn 注册后获取(API Key)
ZHIPU_API_KEY=
# OpenAI 兼容端点(官方文档:https://docs.bigmodel.cn/cn/guide/platform/model-migration)
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# 聊天模型(当前使用 glm-5.3-flash 混合推理;免费档可用 glm-4-flash)
CHAT_MODEL=glm-5.3-flash
# 向量模型与维度(支持 256/512/1024/2048)
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIM=1024
# 无 API Key 时置 1:用本地伪向量干跑整条 RAG 链路(仅开发自测,检索质量无意义)
EMBED_FAKE=0
